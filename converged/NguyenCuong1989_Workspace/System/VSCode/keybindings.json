// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+shift+g",
        "command": "-workbench.view.scm",
        "when": "workbench.scm.active"
    },
    {
        "key": "cmd+alt+p",
        "command": "workbench.action.showCommands"
    },
    {
        "key": "cmd+alt+,",
        "command": "workbench.action.openSettingsJson"
    },
    {
        "key": "cmd+alt+e",
        "command": "workbench.view.extensions"
    },
    {
        "key": "cmd+alt+u",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: infra up"
    },
    {
        "key": "cmd+alt+d",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: infra down"
    },
    {
        "key": "cmd+alt+h",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: health fullstack"
    },
    {
        "key": "cmd+alt+r",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: probe pipeline"
    },
    {
        "key": "cmd+alt+t",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: trace autopilot loop (auto)"
    },
    {
        "key": "cmd+alt+f",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: vscode file tracker (auto)"
    },
    {
        "key": "cmd+alt+m",
        "command": "workbench.action.tasks.runTask",
        "args": "finalAI: vscode master loop (auto)"
    },
    {
        "key": "cmd+alt+x",
        "command": "workbench.action.tasks.terminate"
    }
]