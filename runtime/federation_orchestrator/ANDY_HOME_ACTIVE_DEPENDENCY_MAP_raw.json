        "cmdline": "bash -c python3 - <<'PY'\nimport psutil, json, os, time\nfrom collections import defaultdict\nhome = '/Users/andy'\n\nactors = []\nfor p in psutil.process_iter(['pid','ppid','name','username','cmdline','cwd','exe','create_time']):\n    try:\n        info = p.info\n        if info['username'] != 'andy':\n            continue\n        cmd = ' '.join(info['cmdline'] or [])\n        cwd = info.get('cwd') or ''\n        exe = info.get('exe') or ''\n        # open files\n        files = []\n        try:\n            files = [f.path for f in p.open_files() if f.path.startswith(home)][:20]\n        except (psutil.NoSuchProcess, psutil.AccessDenied):\n            pass\n        conn = []\n        try:\n            for c in p.connections(kind='inet'):\n                if c.status == psutil.CONN_LISTEN:\n                    la = c.laddr\n                    conn.append(f\"{la.ip}:{la.port}\")\n        except (psutil.NoSuchProcess, psutil.AccessDenied):\n            pass\n        if cwd.startswith(home) or any(f.startswith(home) for f in files) or conn:\n            actors.append({\n                'pid': info['pid'],\n                'ppid': info['ppid'],\n                'name': info['name'],\n                'exe': exe,\n                'cmdline': cmd,\n                'cwd': cwd,\n                'listening_ports': conn,\n                'open_files_in_home': files,\n            })\n    except Exception as e:\n        pass\n\n# top-level mapping\nroot_map = defaultdict(list)\ndef top_level(path):\n    if not path.startswith(home):\n        return None\n    rel = path[len(home)+1:]\n    first = rel.split('/')[0]\n    return os.path.join(home, first)\n\nfor a in actors:\n    roots = set()\n    t = top_level(a['cwd'])\n    if t: roots.add(t)\n    for f in a['open_files_in_home']:\n        t = top_level(f)\n        if t: roots.add(t)\n    for r in roots:\n        root_map[r].append({'pid': a['pid'], 'name': a['name'], 'cmdline': a['cmdline'], 'ports': a['listening_ports']})\n\nout = {\n    'timestamp': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n    'home': home,\n    'processes': actors,\n    'top_level_to_processes': {k: v for k, v in sorted(root_map.items())},\n    'summary': {\n        'active_processes_in_home_context': len(actors),\n        'top_level_dirs_with_active_processes': len(root_map)\n    }\n}\nprint(json.dumps(out, indent=2, ensure_ascii=False))\nPY",
