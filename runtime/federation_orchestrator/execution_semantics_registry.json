      "T",
      "G(t)",
      "Th",
      "F",
      "W",
      "D",
      "Trust(P)"
    ],
    "invariants": {
      "surface": "H(t) = T + G(t)",
      "derivative": "dH/dt < 0",
      "limit": "lim t->infinity H(t) = T",
      "integrity": "D = T(W+F) - alpha G(t) - beta Th",
      "trust": "Trust(P) = T(W+F) / (1 + G(t) + Th)",
      "transform": "forall Phi: Phi(M) preserves invariants"
    }
  },
