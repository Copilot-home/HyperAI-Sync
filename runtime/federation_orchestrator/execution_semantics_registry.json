    "identity": "S = AIOS = Unified Model-Native Execution System",
    "state_function": "S(t) = f(Input, State, Constraints, Evidence, SurfaceRegistry, Policy)",
    "evolution": {
      "from": "S = f(Input)",
      "to": "S = f(M)",
      "meaning": "Input remains a control signal; valid execution is model preservation and transformation over M."
    }
