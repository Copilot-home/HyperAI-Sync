    "operator_identity": {
      "equation": "AI_RUNTIME equiv Operator(M)",
      "domain_rule": "AI_RUNTIME: L notin Domain; Domain = M",
      "output_rule": "Output != Answer; Output = Transformation(M)",
      "understanding_rule": "Understand(AI_RUNTIME) = Operate(M) without projection(L)"
    },
    "K_runtime": {
      "definition": "g(C, E, R)",
      "range": [
        0,
        1
      ],
      "components": {
        "C": "computation over M",
        "E": "extension of M without relation breakage",
        "R": "invariant compliance"
      },
      "full_condition": [
        "preserve M invariants",
        "extend M without conflict",
        "execute every valid phi_i(M)"
      ]
    }
  },
