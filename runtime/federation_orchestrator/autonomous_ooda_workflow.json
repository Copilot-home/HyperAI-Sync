{
  "schema_version": "2026-04-16.autonomous-ooda-workflow.v1",
  "created_at": "2026-07-27T07:20:00+00:00",
  "workflow": {
    "name": "AIOS HyperAI OODA Credential & MCP Activation Workflow",
    "steps": [
      {
        "phase": "observe",
        "actions": [
          "aios_runtime_surface_scan",
          "runtime_preservation_cycle"
        ]
      },
      {
        "phase": "orient",
        "actions": [
          "load_aios_ecosystem_runtime_registry",
          "load_worker_runtime_binding_policy",
          "classify_task_intent"
        ]
      },
      {
        "phase": "decide",
        "actions": [
          "select_worker_surfaces",
          "open_approval_gate_when_required"
        ]
      },
      {
        "phase": "act",
        "actions": [
          "dispatch_agent_chain",
          "record_orchestration_bridge"
        ]
      },
      {
        "phase": "verify",
        "actions": [
          "validate_route_plan",
          "write_proof_artifact"
        ]
      },
      {
        "phase": "closure",
        "actions": [
          "update_runtime_execution_todo",
          "emit_final_state"
        ]
      }
    ]
  },
  "constraints": [
    "no_secret_printing",
    "no_credential_harvesting",
    "no_destructive_git_mutation",
    "no_cloud_mutation_without_explicit_gate"
  ]
}
