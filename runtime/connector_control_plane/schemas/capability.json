{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capability",
  "type": "object",
  "required": ["connector_id", "operation", "availability"],
  "properties": {
    "connector_id": {"type": "string"},
    "operation": {"type": "string"},
    "availability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "REQUIRES_REAUTHORIZATION",
        "REQUIRES_PERMISSION",
        "REQUIRES_PLAN_UPGRADE",
        "REQUIRES_ACCOUNT_MODIFICATION",
        "ACCOUNT_NOT_CREATED",
        "SCHEMA_PRESENT_BUT_RUNTIME_MISSING",
        "RUNTIME_TOOL_MISSING",
        "RATE_LIMITED",
        "DEGRADED",
        "BLOCKED",
        "MANUAL_VERIFICATION_REQUIRED"
      ]
    },
    "schema_version": {"type": "string"},
    "last_probe_at": {"type": "string", "format": "date-time"},
    "plan_constraints": {"type": "array", "items": {"type": "string"}},
    "permission_snapshot": {"type": "object"}
  }
}
